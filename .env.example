# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ne mettez JAMAIS le fichier .env sur GitHub (il est dans .gitignore).

# Clé gratuite à créer sur https://console.groq.com/keys
GROQ_API_KEY=

# Modèles essayés dans l'ordre (fallback). Séparés par des virgules.
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
